#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: OCPP Charge Proxy
# Send discovery information to Home Assistant
# ==============================================================================
declare payload

# Wait for the API server to be available
bashio::net.wait_for 8099 localhost 300

# Prepare discovery payload
payload=$(\
    bashio::var.json \
        host "$(hostname)" \
        port "^8099" \
)

if bashio::discovery "ocpp_charge_proxy" "${payload}" > /dev/null; then
    bashio::log.info "Successfully sent discovery information to Home Assistant."
else
    bashio::log.error "Discovery message to Home Assistant failed!"
fi
